---
import CardPlant from './CardPlant.astro';
import CardPlantNew from './CardPlantNew.astro';
import { getCollection } from 'astro:content';

const allPlants = await getCollection('plants');
// Ordenar plantas: primero las que tienen medias, luego las que no
const plants = allPlants.sort((a, b) => {
  const aHasMedias = a.data.medias && Array.isArray(a.data.medias) && a.data.medias.length > 0;
  const bHasMedias = b.data.medias && Array.isArray(b.data.medias) && b.data.medias.length > 0;
  
  if (aHasMedias && !bHasMedias) return -1; // a va primero
  if (!aHasMedias && bHasMedias) return 1;  // b va primero
  return 0; // ambos tienen el mismo estado, mantener orden original
});
const itemsPerPage = 9;
const totalItems = plants.length;

// Importar todas las imágenes una sola vez
---

<div class="container mx-auto px-2 lg:px-0">
  <div id="plants-grid" class="grid grid-cols md:grid-cols-2 xl:grid-cols-4 gap-8">
    {
      plants.map((plant, index) => (
        <div class={`plant-card ${index >= itemsPerPage ? 'hidden' : ''}`}>
          <CardPlantNew {...plant.data} slug={plant.slug} />
        </div>
      ))
    }
  </div>
  {
    totalItems > itemsPerPage && (
      <div class="flex justify-center mt-8 pb-36">
        <button 
          id="load-more"
          class="text-alto-jardin-1 bg-alto-jardin-3 px-6 py-3 rounded-lg hover:bg-alto-jardin-3/80 transition-colors cursor-pointer"
        >
          Ver más
        </button>
      </div>
    )
  }
</div>

<script>
  const loadData = () => {
  let currentItems = 9;
  const itemsPerPage = 9;
  
  document.getElementById('load-more')?.addEventListener('click', () => {
    const cards = document.querySelectorAll('.plant-card.hidden');
    const nextCards = Array.from(cards).slice(0, itemsPerPage);
    
    nextCards.forEach(card => {
      card.classList.remove('hidden');
    });
    
    currentItems += itemsPerPage;
    
    // Hide the button if no more cards to show
    if (cards.length <= itemsPerPage) {
      const button = document.getElementById('load-more');
      if (button) button.style.display = 'none';
    }
  });
  }
  document.addEventListener("astro:page-load", loadData);
  loadData();
</script>
