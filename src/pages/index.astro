---
import Layout from '../layouts/Layout.astro';
import SwiperBanner from '../components/SwiperBanner.astro';
import CardCategoryPlantList from '../components/CategoryPlantList.astro';
import ContactInfo from '../components/ContactInfo.astro';

import { getEntry } from 'astro:content';

const imperial = await getEntry('plants', 'veranera-envarada-comun');
const patricia = await getEntry('plants', 'patricia');
const porcelana = await getEntry('plants', 'porcelana');
const veraneras = [imperial, patricia, porcelana];

const rosas = await getEntry('plants', 'rosas');
const troncoDeLaFelicidad = await getEntry('plants', 'tronco-de-la-felicidad');
const miniRosos = await getEntry('plants', 'mini-rosos');
const canabis = await getEntry('plants', 'canabis-marihuana');

const masVendidas = [rosas, troncoDeLaFelicidad, miniRosos, canabis];
---

<Layout
  title="Alto Jardin - Vivero de Plantas Ornamentales | Suculentas, Palmas y Flores"
  description="Alto Jardin es tu vivero de confianza en Colombia. Especialistas en plantas ornamentales, suculentas, palmas y flores. Amplia variedad de plantas para interior y exterior. Entrega a domicilio disponible."
  image="https://alto-jardin.vercel.app/og-image.jpg"
>
  <section
    class="mx-auto w-5xl h-[480px] mt-8 mb-16 rounded-2xl overflow-hidden"
  >
    <SwiperBanner />
  </section>
  <section
    class="mx-auto w-5xl mt-8 mb-16 rounded-2xl overflow-hidden flex flex-col gap-16"
  >
    <CardCategoryPlantList
      category="Buganvillas/Veraneras"
      plants={veraneras}
    />
    <CardCategoryPlantList category="Mas vendidas" plants={masVendidas} />
  </section>
  <section
    class="mx-auto w-5xl mt-8 mb-16 rounded-2xl overflow-hidden flex flex-col justify-center items-center gap-16"
  >
    <h2 class="font-extrabold text-8xl text-alto-jardin-1 text-center">
      ¡Haz crecer tu negocio con Alto Jardín!
    </h2>
    <p class="text-center text-xl font-normal text-alto-jardin-1 max-w-3xl">
      Alto jardin esta ubicado en Fusagasuga, Cundinamarca. Ofrecemos
      diferentes servicios desde envio directo por parte de nuestros vehiculos
      hasta la recepcion de listas/cotizaciones y recogida en nuestro vivero para que con tu
      vehiculo puedas realizar el viaje de manera comoda y segura.
    </p>
          <a href={`https://api.whatsapp.com/send?phone=573138037661&text=Hola%2C%20quisiera%20mas%20informacion`} target="_blank"
            class="border border-alto-jardin-2 rounded-xl shadow-lg p-4 lg:p-6 flex flex-col justify-center items-center"
          >
            <div>
              
            <svg
              width="64px"
              height="64px"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
                id="SVGRepo_tracerCarrier"
                stroke-linecap="round"
                stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
                <path
                  d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z"
                  fill="#4e976b"></path>
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z"
                  fill="#4e976b"></path>
              </g></svg
            >
            </div>
            <span class="font-medium text-alto-jardin-1 text-sm">
              WhastApp
            </span>
            <span class="font-medium text-alto-jardin-1/50 text-xs text-center">
              Contactanos
            </span>
          </a>
  </section>
  <section class="mx-auto w-5xl mt-8 mb-16">
    <ContactInfo />
  </section>
</Layout>
