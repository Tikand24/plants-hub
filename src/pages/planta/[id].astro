---
import Layout from '../../layouts/Layout.astro';
import Image from 'astro/components/Image.astro';
import { getCollection, render } from 'astro:content';
import logoFinal from '../../images/logofinal.jpg';

export async function getStaticPaths() {
  const plants = await getCollection('plants');
  return plants.map((plant) => ({
    params: { id: plant.slug },
    props: { plant: plant },
  }));
}

const { plant } = Astro.props;
const { data, slug } = plant;

const { medias, name, generalDescription, price, type, _id } = data;
const { Content } = await render(plant);

// Group type array into pairs
const groupedTypes = type.reduce((acc: any[], curr: any, i: number) => {
  if (i % 2 === 0) {
    acc.push([curr]);
  } else {
    acc[acc.length - 1].push(curr);
  }
  return acc;
}, []);
// Obtener la primera imagen del array medias
export const prerender = true;
---

<Layout title={`${name} - Alto Jardín | Vivero`}>
  <div class="container mx-auto px-2 lg:px-0">
    <article class="flex flex-col lg:flex-row gap-4 lg:gap-16">
      <section class="flex flex-col lg:flex-row gap-4 lg:w-1/3">
        <div class="w-full lg:w-1/2 block lg:hidden">
          <h1 class="text-2xl text-alto-jardin-1 font-semibold">{name}</h1>
        </div>
        <div class="w-full">
          <div class="swiper swiper-main mb-4">
            {
              medias.length > 0 ? (
                <div class="swiper-wrapper">
                  {medias.map((img, index) => (
                    <div class="swiper-slide">
                      <Image
                        src={img.filename}
                        alt={`${name}-${index}`}
                        width={400}
                        height={300}
                        transition:name={`${slug}-img`}
                        class="w-full h-full max-h-[80vh] lg:max-h-[70vh] object-cover rounded-xl"
                      />
                    </div>
                  ))}
